{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "aiojisan.com" }],
      "destination": "https://www.aiojisan.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/fetch-sources",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-articles",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/refresh-priority-sources",
      "schedule": "0 6,18 * * *"
    }
  ]
}
