---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { EDITORIAL_DISPLAY_CATEGORIES as EDITORIAL_CATEGORIES } from '@/services/editorial/pillars';
import { stripHtml } from '@/lib/html';

type EditorialCategory = (typeof EDITORIAL_CATEGORIES)[number];

type WpTerm = {
  id: number;
  name: string;
  slug: string;
};

type WpPost = {
  id: number;
  slug: string;
  title: { rendered: string };
  excerpt: { rendered: string };
  date: string;
  link: string;
  categories: number[];
  featured_media: number;
  _embedded?: {
    'wp:featuredmedia'?: { source_url: string; alt_text: string }[];
    'wp:term'?: WpTerm[][];
  };
};

type ArticleCard = {
  slug: string;
  title: string;
  excerpt: string;
  publishedAt: string;
  link: string;
  thumbnail: string | null;
  category: EditorialCategory;
};

async function fetchWpPosts(perPage = 24): Promise<WpPost[]> {
  const base = import.meta.env.WORDPRESS_BASE_URL?.replace(/\/$/, '') ?? '';
  try {
    const res = await fetch(
      `${base}/wp-json/wp/v2/posts?per_page=${perPage}&status=publish&_embed=wp:featuredmedia,wp:term&_fields=id,slug,title,excerpt,date,link,featured_media,categories,_embedded,_links`
    );
    if (!res.ok) return [];
    return res.json();
  } catch {
    return [];
  }
}

function getEditorialCategory(post: WpPost): EditorialCategory {
  const terms = post._embedded?.['wp:term']?.flat() ?? [];
  const matchedTerm = terms.find(term =>
    EDITORIAL_CATEGORIES.some(category => category.slug === term.slug)
  );

  return EDITORIAL_CATEGORIES.find(category => category.slug === matchedTerm?.slug)
    ?? EDITORIAL_CATEGORIES[0];
}

const wpPosts = await fetchWpPosts();

const latestArticles: ArticleCard[] = wpPosts.map(p => ({
  slug: p.slug,
  title: stripHtml(p.title.rendered),
  excerpt: stripHtml(p.excerpt.rendered),
  publishedAt: p.date,
  link: p.link,
  thumbnail: p._embedded?.['wp:featuredmedia']?.[0]?.source_url ?? null,
  category: getEditorialCategory(p),
}));

const articlesByCategory = EDITORIAL_CATEGORIES.map(category => ({
  category,
  articles: latestArticles.filter(article => article.category.slug === category.slug),
})).filter(group => group.articles.length > 0);

const featuredArticles = EDITORIAL_CATEGORIES
  .map(category => latestArticles.find(article => article.category.slug === category.slug))
  .filter((article): article is ArticleCard => Boolean(article));

// 四本柱インデックス: 記事ゼロの柱も含めて常に4本立てる（鮮度=最新記事日付を足元に）
const pillarIndex = EDITORIAL_CATEGORIES.map(category => ({
  ...category,
  latestDate: latestArticles.find(article => article.category.slug === category.slug)?.publishedAt ?? null,
}));

// 注目の記事: 最新の1本をリードに、残りを右レールへ
const featuredByDate = [...featuredArticles].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
);
const leadArticle = featuredByDate[0] ?? null;
const railArticles = featuredByDate.slice(1);

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AIおじさんのひとりごと',
  alternateName: 'AIおじさん',
  url: 'https://www.aiojisan.com/',
  description: '生成AI、AI駆動開発、フィジカルAI、海外AIビジネスの4本柱を実務目線で読み解くメディア',
  publisher: {
    '@type': 'Organization',
    name: 'AIおじさんのひとりごと',
    url: 'https://www.aiojisan.com/',
  },
};
---

<PublicLayout
  title="AIおじさんのひとりごと"
  description="AIおじさんのひとりごと。生成AI、AI駆動開発、フィジカルAI、海外AIビジネスの4本柱を実務目線で読み解くニュース分析メディアです。"
  jsonLd={homeJsonLd}
>
  <!-- Hero + 四本柱 index -->
  <section class="max-w-admin mx-auto px-6 pt-16 pb-14">
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-14">
      <div class="max-w-2xl">
        <p class="text-sm text-accent font-medium mb-3 uppercase tracking-wide">AIおじさんのひとりごと</p>
        <h1 class="text-4xl font-semibold text-text-primary leading-tight mb-4">
          実務目線で読み解く<br />AIニュースの判断軸
        </h1>
        <p class="text-lg text-text-secondary leading-relaxed">
          生成AI・AI駆動開発・フィジカルAI・海外AIビジネス。
          4つの柱を横断して、「なぜ重要か」「実務にどう響くか」を自分なりの視点で書いています。
        </p>
      </div>
      <nav class="pillar-index mt-10 lg:mt-0 lg:w-96 shrink-0" aria-label="4本柱">
        {pillarIndex.map(pillar => (
          <a href={`/articles?category=${encodeURIComponent(pillar.slug)}`} class="pillar" title={pillar.description}>
            <span class="pillar-tick" aria-hidden="true"></span>
            <span class="pillar-label">{pillar.label}</span>
            <span class="pillar-date">
              {pillar.latestDate
                ? new Date(pillar.latestDate).toLocaleDateString('ja-JP', { month: 'numeric', day: 'numeric' })
                : '準備中'}
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-admin mx-auto px-6">
    <hr class="border-border" />
  </div>

  <!-- Featured: lead story + rail -->
  {leadArticle && (
    <section class="max-w-admin mx-auto px-6 py-12">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-xs font-medium text-text-muted uppercase tracking-widest">
          注目の記事
        </h2>
        <a href="/articles" class="hidden sm:inline text-sm text-accent hover:underline">記事一覧 →</a>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
        <a href={`/articles/${leadArticle.slug}`} class="group lg:col-span-3 block">
          {leadArticle.thumbnail && (
            <div class="aspect-video overflow-hidden rounded-lg border border-border bg-[#F0F0EE]">
              <img
                src={leadArticle.thumbnail}
                alt={leadArticle.title}
                class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )}
          <div class="pt-5">
            <span class="text-xs text-accent font-medium uppercase tracking-wide">
              {leadArticle.category.label}
            </span>
            <h3 class="text-2xl font-semibold text-text-primary mt-2 mb-3 leading-snug group-hover:text-accent transition-colors">
              {leadArticle.title}
            </h3>
            <p class="text-base text-text-secondary leading-relaxed line-clamp-3">
              {leadArticle.excerpt}
            </p>
            <p class="text-xs text-text-muted mt-3 font-mono">
              {new Date(leadArticle.publishedAt).toLocaleDateString('ja-JP')}
            </p>
          </div>
        </a>
        <div class="lg:col-span-2 flex flex-col divide-y divide-border">
          {railArticles.map(article => (
            <a href={`/articles/${article.slug}`} class="group flex items-start gap-4 py-5 first:pt-0 last:pb-0">
              {article.thumbnail && (
                <div class="w-28 h-[4.5rem] shrink-0 overflow-hidden rounded border border-border bg-[#F0F0EE]">
                  <img
                    src={article.thumbnail}
                    alt={article.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="min-w-0">
                <span class="text-xs text-accent font-medium uppercase tracking-wide">
                  {article.category.label}
                </span>
                <h3 class="text-sm font-semibold text-text-primary mt-1 leading-snug line-clamp-2 group-hover:text-accent transition-colors">
                  {article.title}
                </h3>
                <p class="text-xs text-text-muted mt-1.5 font-mono">
                  {new Date(article.publishedAt).toLocaleDateString('ja-JP')}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest articles -->
  <section class="max-w-admin mx-auto px-6 py-10">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-xs font-medium text-text-muted uppercase tracking-widest">最新記事</h2>
      <a href="/articles" class="text-sm text-accent hover:underline">すべて見る →</a>
    </div>

    {latestArticles.length === 0 ? (
      <div class="py-16 text-center">
        <p class="text-text-muted text-sm">記事を準備中です</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        {articlesByCategory.map(({ category, articles }) => (
          <section class="min-w-0">
            <div class="mb-4">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="text-lg font-semibold text-text-primary">{category.label}</h3>
                <a
                  href={`/articles?category=${encodeURIComponent(category.slug)}`}
                  class="text-xs text-accent hover:underline whitespace-nowrap"
                >
                  もっと見る
                </a>
              </div>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{category.description}</p>
            </div>
            <div class="space-y-0 divide-y divide-border">
              {articles.slice(0, 4).map(article => (
                <a href={`/articles/${article.slug}`}
                  class="group block py-4 hover:bg-[#F5F5F3] -mx-3 px-3 rounded transition-colors">
                  <div class="flex items-start gap-3">
                    {article.thumbnail && (
                      <div class="w-20 h-14 flex-shrink-0 rounded overflow-hidden bg-[#F0F0EE]">
                        <img
                          src={article.thumbnail}
                          alt={article.title}
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="flex-1 min-w-0">
                      <p class="text-xs text-text-muted mb-1.5">
                        {new Date(article.publishedAt).toLocaleDateString('ja-JP')}
                      </p>
                      <h4 class="text-sm font-medium text-text-primary leading-snug group-hover:text-accent transition-colors mb-1.5">
                        {article.title}
                      </h4>
                      <p class="text-xs text-text-secondary leading-relaxed line-clamp-2">
                        {article.excerpt}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </section>
</PublicLayout>

<style>
  /* 四本柱インデックス — 縦書き明朝の柱。サイトの編集方針「4本柱」をそのまま形にする */
  .pillar-index {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 15rem;
    padding: 1rem 0.5rem 0.85rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .pillar:hover,
  .pillar:focus-visible {
    border-color: var(--color-accent);
  }
  .pillar:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .pillar-tick {
    width: 2px;
    height: 0.9rem;
    background: var(--color-accent);
    transition: height 0.2s ease;
  }
  .pillar:hover .pillar-tick {
    height: 1.6rem;
  }
  .pillar-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    color: var(--color-text-primary);
    flex: 1;
    padding-top: 0.7rem;
    transition: color 0.2s ease;
  }
  .pillar:hover .pillar-label {
    color: var(--color-accent);
  }
  .pillar-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pillar:hover {
      transform: translateY(-3px);
    }
  }
  @media (max-width: 480px) {
    .pillar {
      height: 12.5rem;
    }
    .pillar-label {
      font-size: 0.9rem;
      letter-spacing: 0.2em;
    }
  }
</style>
