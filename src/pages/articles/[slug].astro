---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { stripHtml } from '@/lib/html';

const { slug } = Astro.params;

const base = import.meta.env.WORDPRESS_BASE_URL?.replace(/\/$/, '') ?? '';

interface WpPost {
  id: number;
  slug: string;
  date: string;
  modified?: string;
  title: { rendered: string };
  content: { rendered: string };
  excerpt: { rendered: string };
  link: string;
  categories?: number[];
  _embedded?: {
    'wp:featuredmedia'?: Array<{ source_url: string; alt_text: string }>;
    'wp:term'?: Array<Array<{ id: number; name: string; slug: string }>>;
  };
}

let post: WpPost | null = null;

try {
  const res = await fetch(
    `${base}/wp-json/wp/v2/posts?slug=${encodeURIComponent(slug!)}&_embed=1&status=publish`,
    { cache: 'no-store' },
  );
  if (res.ok) {
    const posts: WpPost[] = await res.json();
    post = posts[0] ?? null;
  }
} catch {
  // fall through to redirect
}

if (!post) {
  return Astro.redirect('/articles');
}

async function fetchRelatedPosts(currentPost: WpPost): Promise<WpPost[]> {
  const seen = new Set<number>([currentPost.id]);
  const related: WpPost[] = [];
  const categoryIds = currentPost.categories ?? [];

  async function fetchPosts(params: URLSearchParams): Promise<WpPost[]> {
    try {
      params.set('status', 'publish');
      params.set('orderby', 'date');
      params.set('order', 'desc');
      params.set('_embed', '1');

      const res = await fetch(`${base}/wp-json/wp/v2/posts?${params}`, {
        cache: 'no-store',
      });
      if (!res.ok) return [];
      return res.json();
    } catch {
      return [];
    }
  }

  function addPosts(posts: WpPost[]) {
    for (const candidate of posts) {
      if (seen.has(candidate.id)) continue;
      seen.add(candidate.id);
      related.push(candidate);
      if (related.length >= 4) break;
    }
  }

  if (categoryIds.length > 0) {
    addPosts(await fetchPosts(new URLSearchParams({
      per_page: '8',
      categories: categoryIds.join(','),
      exclude: String(currentPost.id),
    })));
  }

  if (related.length < 4) {
    addPosts(await fetchPosts(new URLSearchParams({
      per_page: '8',
      exclude: Array.from(seen).join(','),
    })));
  }

  return related;
}

const title = stripHtml(post.title.rendered);
const excerpt = stripHtml(post.excerpt.rendered).slice(0, 160);
const featuredImage = post._embedded?.['wp:featuredmedia']?.[0];
const categories = post._embedded?.['wp:term']?.[0] ?? [];
const primaryCategory = categories[0];
const relatedPosts = await fetchRelatedPosts(post);
const relatedArticles = relatedPosts.map(relatedPost => {
  const relatedCategory = relatedPost._embedded?.['wp:term']?.[0]?.[0];
  const relatedImage = relatedPost._embedded?.['wp:featuredmedia']?.[0];

  return {
    slug: relatedPost.slug,
    title: stripHtml(relatedPost.title.rendered),
    excerpt: stripHtml(relatedPost.excerpt.rendered),
    publishedAt: relatedPost.date,
    thumbnail: relatedImage?.source_url ?? null,
    categoryName: relatedCategory?.name ?? 'AI分析',
  };
});
const publishedAt = new Date(post.date).toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const canonicalUrl = `https://www.aiojisan.com/articles/${post.slug}`;
const shareText = `${title} — AIおじさんのひとりごと`;
const xShareUrl = `https://twitter.com/intent/tweet?${new URLSearchParams({
  text: shareText,
  url: canonicalUrl,
  hashtags: 'AIおじさん,生成AI',
}).toString()}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  url: canonicalUrl,
  datePublished: post.date,
  dateModified: post.modified ?? post.date,
  image: featuredImage?.source_url ?? undefined,
  author: {
    '@type': 'Person',
    name: 'AIおじさん',
    url: 'https://www.aiojisan.com/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'AIおじさんのひとりごと',
    url: 'https://www.aiojisan.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
---

<PublicLayout
  title={title}
  description={excerpt}
  ogImage={featuredImage?.source_url}
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <article class="max-w-prose mx-auto px-6 py-12">

    <!-- Back link -->
    <div class="mb-8">
      <a href="/articles" class="text-sm text-text-muted hover:text-accent transition-colors">
        ← 記事一覧
      </a>
    </div>

    <!-- Meta -->
    <div class="flex items-center gap-3 mb-4">
      {primaryCategory && (
        <a
          href={`/articles?category=${primaryCategory.slug}`}
          class="text-xs text-accent font-medium hover:underline"
        >
          {primaryCategory.name}
        </a>
      )}
      <span class="text-xs text-text-muted">{publishedAt}</span>
    </div>

    <!-- Title -->
    <h1 class="text-3xl font-semibold text-text-primary leading-tight mb-6">
      {title}
    </h1>

    <!-- Share -->
    <div class="mb-8">
      <a
        href={xShareUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3 py-1.5 border border-border rounded-full text-xs font-medium text-text-secondary hover:text-accent hover:border-accent transition-colors"
        aria-label="この記事をXでシェア"
      >
        <span class="text-sm leading-none">𝕏</span>
        <span>シェアする</span>
      </a>
    </div>

    <!-- Featured image -->
    {featuredImage && (
      <div class="mb-8 rounded-md overflow-hidden">
        <img
          src={featuredImage.source_url}
          alt={featuredImage.alt_text || title}
          class="w-full object-cover"
          loading="eager"
        />
      </div>
    )}

    <!-- Article body -->
    <div class="article-body" set:html={post.content.rendered} />

    <!-- Source link -->
    <div class="mt-10 pt-6 border-t border-border">
      <a
        href={post.link}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-text-muted hover:text-accent transition-colors"
      >
        元記事を読む →
      </a>
    </div>

    <!-- Share footer -->
    <div class="mt-8">
      <a
        href={xShareUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3 py-1.5 border border-border rounded-full text-xs font-medium text-text-secondary hover:text-accent hover:border-accent transition-colors"
        aria-label="この記事をXでシェア"
      >
        <span class="text-sm leading-none">𝕏</span>
        <span>この記事をシェアする</span>
      </a>
    </div>

    <!-- Related articles -->
    {relatedArticles.length > 0 && (
      <section class="mt-12 pt-8 border-t border-border">
        <div class="flex items-baseline justify-between mb-5">
          <h2 class="text-lg font-semibold text-text-primary">関連記事</h2>
          {primaryCategory && (
            <a
              href={`/articles?category=${primaryCategory.slug}`}
              class="text-sm text-accent hover:underline"
            >
              {primaryCategory.name} の記事を見る →
            </a>
          )}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedArticles.map(article => (
            <a
              href={`/articles/${article.slug}`}
              class="group border border-border rounded-lg overflow-hidden bg-surface hover:border-accent/40 transition-colors"
            >
              {article.thumbnail && (
                <div class="aspect-video overflow-hidden bg-[#F0F0EE]">
                  <img
                    src={article.thumbnail}
                    alt={article.title}
                    class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-4">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs text-accent font-medium">{article.categoryName}</span>
                  <span class="text-xs text-text-muted">
                    {new Date(article.publishedAt).toLocaleDateString('ja-JP')}
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-text-primary leading-snug group-hover:text-accent transition-colors mb-2">
                  {article.title}
                </h3>
                <p class="text-xs text-text-secondary leading-relaxed line-clamp-2">
                  {article.excerpt}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </article>
</PublicLayout>
