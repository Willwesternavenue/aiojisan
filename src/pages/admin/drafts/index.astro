---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDraftsPage } from '@/lib/supabase/queries';

const PAGE_SIZE = 50;
const pageParam = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isFinite(pageParam) && pageParam >= 1 ? Math.floor(pageParam) : 1;

const { rows: drafts, total } = await getDraftsPage(page, PAGE_SIZE).catch(() => ({ rows: [], total: 0 }));
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const start = total === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
const end = (page - 1) * PAGE_SIZE + drafts.length;
const hasPrev = page > 1;
const hasNext = page < totalPages;
const prevHref = `?page=${page - 1}`;
const nextHref = `?page=${page + 1}`;

const regenerated = Astro.url.searchParams.get('regenerated') === '1';
const imgDone = Astro.url.searchParams.get('img_done');
const imgFail = Astro.url.searchParams.get('img_fail');
const imgLeft = Astro.url.searchParams.get('img_left');
const showImgResult = imgDone !== null;
const missing = Astro.url.searchParams.get('missing') === '1';
---

<AdminLayout title="下書き履歴" activeNav="drafts">
  {missing && (
    <div class="mb-4 px-4 py-2 rounded-md bg-score-lowBg text-score-low text-sm">
      その下書きは見つかりませんでした。削除された可能性があります。
    </div>
  )}

  {regenerated && (
    <div class="mb-4 px-4 py-2 rounded-md bg-score-highBg text-score-high text-sm">
      記事を再生成し、WordPress本文を更新しました。
    </div>
  )}

  {showImgResult && (
    <div class="mb-4 px-4 py-2 rounded-md bg-score-highBg text-score-high text-sm">
      画像を {imgDone} 件生成しました（失敗 {imgFail} ／ 残り {imgLeft}）。{Number(imgLeft) > 0 && ' もう一度押すと続きを処理します。'}
    </div>
  )}

  <div class="mb-3">
    <form method="POST" action="/api/admin/images/backfill">
      <button
        type="submit"
        class="text-xs text-accent border border-border rounded px-3 py-1.5 hover:bg-[#F0F0EE] transition-colors"
      >
        画像が無い記事に一括生成（最大5件）
      </button>
    </form>
  </div>

  <div class="mb-3 flex items-center justify-between gap-3 flex-wrap">
    <input
      id="draft-search"
      type="search"
      placeholder="このページ内を絞り込み（タイトル・元記事・URL）"
      class="w-full max-w-md px-3 py-1.5 text-sm border border-border rounded-md bg-surface text-text-primary focus:outline-none focus:border-accent"
    />
    <div class="flex items-center gap-3 text-xs text-text-muted whitespace-nowrap">
      <span>全 {total} 件 ・ {start}–{end} 件目（{page} / {totalPages} ページ）</span>
      <div class="flex items-center gap-1">
        {hasPrev ? (
          <a href={prevHref} class="border border-border rounded px-2 py-0.5 text-accent hover:bg-[#F0F0EE] transition-colors">← 前</a>
        ) : (
          <span class="border border-border rounded px-2 py-0.5 opacity-40">← 前</span>
        )}
        {hasNext ? (
          <a href={nextHref} class="border border-border rounded px-2 py-0.5 text-accent hover:bg-[#F0F0EE] transition-colors">次 →</a>
        ) : (
          <span class="border border-border rounded px-2 py-0.5 opacity-40">次 →</span>
        )}
      </div>
    </div>
  </div>

  <div id="draft-list" class="bg-surface border border-border rounded-md divide-y divide-border">
    {drafts.length === 0 && (
      <div class="px-5 py-8 text-center">
        <p class="text-sm text-text-muted">下書きがまだ生成されていません</p>
      </div>
    )}
    {drafts.map(draft => (
      <div
        class="draft-row px-5 py-4 flex items-start justify-between gap-4"
        data-search={`${draft.draft_title} ${draft.articles?.title ?? ''} ${draft.articles?.canonical_url ?? ''}`.toLowerCase()}
      >
        <div class="min-w-0">
          <p class="text-sm font-medium text-text-primary mb-0.5">{draft.draft_title}</p>
          <p class="text-xs text-text-muted">
            元記事: {draft.articles?.title ?? '不明'}
          </p>
          <p class="text-xs text-text-muted">
            {new Date(draft.created_at).toLocaleString('ja-JP')}
          </p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <span class:list={[
            'inline-block px-2 py-0.5 rounded text-xs',
            draft.status === 'sent_to_wordpress' ? 'bg-blue-50 text-blue-600' :
            draft.status === 'published' ? 'bg-score-highBg text-score-high' :
            'bg-[#F0F0EE] text-text-secondary',
          ]}>
            {draft.status}
          </span>
          <a href={`/admin/drafts/${draft.id}`} class="text-xs text-accent hover:underline">
            詳細
          </a>
          {draft.wordpress_post_id && (
            <a
              href={`${import.meta.env.WORDPRESS_BASE_URL}/wp-admin/post.php?post=${draft.wordpress_post_id}&action=edit`}
              target="_blank" rel="noopener noreferrer"
              class="text-xs text-text-secondary hover:text-text-primary border border-border rounded px-2 py-0.5 hover:bg-[#F0F0EE] transition-colors"
            >
              WPで開く ↗
            </a>
          )}
          {draft.wordpress_post_id && draft.article_id && (
            <form method="POST" action="/api/admin/drafts/regenerate">
              <input type="hidden" name="article_id" value={draft.article_id} />
              <button
                type="submit"
                class="text-xs text-accent border border-border rounded px-2 py-0.5 hover:bg-[#F0F0EE] transition-colors"
              >
                再生成
              </button>
            </form>
          )}
        </div>
      </div>
    ))}
    <div id="draft-empty" class="px-5 py-8 text-center hidden">
      <p class="text-sm text-text-muted">該当する下書きがありません</p>
    </div>
  </div>

  {totalPages > 1 && (
    <div class="mt-4 flex items-center justify-center gap-3 text-xs">
      {hasPrev ? (
        <a href={prevHref} class="border border-border rounded px-3 py-1 text-accent hover:bg-[#F0F0EE] transition-colors">← 前の50件</a>
      ) : (
        <span class="border border-border rounded px-3 py-1 opacity-40">← 前の50件</span>
      )}
      <span class="text-text-muted">{page} / {totalPages}</span>
      {hasNext ? (
        <a href={nextHref} class="border border-border rounded px-3 py-1 text-accent hover:bg-[#F0F0EE] transition-colors">次の50件 →</a>
      ) : (
        <span class="border border-border rounded px-3 py-1 opacity-40">次の50件 →</span>
      )}
    </div>
  )}

  <script is:inline>
    (function () {
      const input = document.getElementById('draft-search');
      const rows = Array.from(document.querySelectorAll('.draft-row'));
      const countEl = document.getElementById('draft-count');
      const emptyEl = document.getElementById('draft-empty');
      if (!input) return;
      input.addEventListener('input', function () {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const row of rows) {
          const hay = row.getAttribute('data-search') || '';
          const match = q === '' || hay.indexOf(q) !== -1;
          row.classList.toggle('hidden', !match);
          if (match) visible++;
        }
        if (countEl) countEl.textContent = String(visible);
        if (emptyEl) emptyEl.classList.toggle('hidden', visible !== 0);
      });
    })();
  </script>
</AdminLayout>
