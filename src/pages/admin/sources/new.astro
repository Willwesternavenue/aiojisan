---
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout title="ソースを追加" activeNav="sources">
  <div class="max-w-2xl">
    <form method="POST" action="/api/admin/sources" class="space-y-5">
      <div class="bg-surface border border-border rounded-md p-6 space-y-5">

        <div class="field">
          <label for="name">ソース名 <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required
            placeholder="例: TechCrunch Japan" class="input" />
        </div>

        <div class="field">
          <label for="source_type">タイプ <span class="text-red-500">*</span></label>
          <select id="source_type" name="source_type" required class="input">
            <option value="rss">RSS</option>
            <option value="html">HTML fetch</option>
            <option value="playwright">Playwright</option>
          </select>
          <p class="hint">RSS が利用可能な場合は優先的に使用してください</p>
        </div>

        <div class="field">
          <label for="base_url">ベースURL <span class="text-red-500">*</span></label>
          <input type="url" id="base_url" name="base_url" required
            placeholder="https://example.com" class="input" />
        </div>

        <div class="field">
          <label for="list_url">フィード / 一覧URL <span class="text-red-500">*</span></label>
          <input type="url" id="list_url" name="list_url" required
            placeholder="https://example.com/feed.xml" class="input" />
          <p class="hint">RSS の場合はフィードURL、HTML の場合は一覧ページURL</p>
        </div>

        <div class="field">
          <label for="priority">優先度</label>
          <input type="number" id="priority" name="priority" value="5" min="1" max="10" class="input w-24" />
          <p class="hint">1〜10。高いほど優先的に処理されます</p>
        </div>

        <div class="field">
          <label for="tags">タグ（カンマ区切り）</label>
          <input type="text" id="tags" name="tags"
            placeholder="AI, 生成AI, スタートアップ" class="input" />
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="enabled" name="enabled" value="true" checked class="rounded border-border" />
          <label for="enabled" class="text-sm text-text-primary cursor-pointer">有効にする</label>
        </div>

      </div>

      <div class="flex gap-3">
        <button type="submit" class="btn-primary">保存する</button>
        <a href="/admin/sources" class="btn-secondary">キャンセル</a>
      </div>
    </form>
  </div>
</AdminLayout>
