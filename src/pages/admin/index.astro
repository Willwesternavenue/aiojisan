---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDashboardStats } from '@/lib/supabase/queries';
import { getAdminClient } from '@/lib/supabase/server';

const stats = await getDashboardStats().catch(() => ({
  enabledSources: 0, newArticlesToday: 0, highScoreItems: 0, draftsThisWeek: 0,
}));

// Recent source runs
const db = getAdminClient();
let recentRunsRaw: unknown[] = [];
try {
  const { data } = await db
    .from('source_runs')
    .select('*, sources(name)')
    .order('started_at', { ascending: false })
    .limit(10);
  recentRunsRaw = data ?? [];
} catch {
  recentRunsRaw = [];
}

type RunRow = {
  id: string;
  status: string;
  items_inserted: number;
  items_found: number;
  started_at: string;
  sources: { name: string } | null;
};
const recentRuns = (recentRunsRaw ?? []) as RunRow[];

// System alerts (last 7 days). Several pipeline steps swallow their failures
// so a provider hiccup never blocks publishing; this is where those surface.
type AlertRow = { source: string; kind: string; message: string; created_at: string };
let alerts: AlertRow[] = [];
try {
  const { data } = await db
    .from('system_alerts')
    .select('source, kind, message, created_at')
    .gte('created_at', new Date(Date.now() - 7 * 24 * 3600_000).toISOString())
    .order('created_at', { ascending: false })
    .limit(20);
  alerts = (data ?? []) as AlertRow[];
} catch {
  alerts = [];
}

const ALERT_LABEL: Record<string, string> = {
  quota:           'AIクレジット枯渇',
  unrecorded_post: '記録なしの公開記事',
  image_failed:    'アイキャッチ生成失敗',
  category_failed: 'カテゴリ未付与',
  social_failed:   'X投稿失敗',
  source_failed:   'ソース取り込み失敗',
  research_failed: '下調べ失敗',
};

const ALERT_ACTION: Record<string, string> = {
  quota:           '各プロバイダの残高を確認してください',
  unrecorded_post: 'WordPress側に記録のない記事が残っています。重複の恐れがあります',
  image_failed:    '下書き履歴の「画像が無い記事に一括生成」で補完できます',
  category_failed: '記事が柱の一覧に出ません。WordPressでカテゴリを付けてください',
  social_failed:   '記事は公開済みですが未投稿です。必要なら手動で投稿してください',
  source_failed:   'ソース管理でフィードURLと疎通を確認してください',
  research_failed: '出典なしで書かれています。公開前に内容を確認してください',
};
---

<AdminLayout title="ダッシュボード" activeNav="dashboard">
  {alerts.length > 0 && (
    <div class="mb-6 border border-score-low/30 rounded-md overflow-hidden">
      <p class="px-4 py-2 bg-score-lowBg text-score-low text-sm font-semibold">
        要確認 {alerts.length} 件（過去7日）
      </p>
      <ul class="divide-y divide-border bg-surface">
        {alerts.map(a => (
          <li class="px-4 py-3">
            <div class="flex items-baseline gap-2 flex-wrap">
              <span class="text-xs font-medium text-score-low">
                {ALERT_LABEL[a.kind] ?? a.kind}
              </span>
              <span class="text-xs text-text-muted">
                {new Date(a.created_at).toLocaleString('ja-JP')}
              </span>
            </div>
            <p class="text-xs text-text-secondary mt-1">
              {ALERT_ACTION[a.kind] ?? a.message}
            </p>
            <p class="text-[11px] text-text-muted mt-0.5 font-mono break-all">{a.message}</p>
          </li>
        ))}
      </ul>
    </div>
  )}
  <!-- Stats row -->
  <div class="grid grid-cols-4 gap-4 mb-8">
    <div class="bg-surface border border-border rounded-md p-4">
      <p class="text-xs text-text-muted uppercase tracking-wide">有効ソース数</p>
      <p class="text-3xl font-semibold text-text-primary mt-1">{stats.enabledSources}</p>
    </div>
    <div class="bg-surface border border-border rounded-md p-4">
      <p class="text-xs text-text-muted uppercase tracking-wide">新着（24h）</p>
      <p class="text-3xl font-semibold text-text-primary mt-1">{stats.newArticlesToday}</p>
    </div>
    <div class="bg-surface border border-border rounded-md p-4">
      <p class="text-xs text-text-muted uppercase tracking-wide">高スコア記事</p>
      <p class="text-3xl font-semibold text-text-primary mt-1">{stats.highScoreItems}</p>
    </div>
    <div class="bg-surface border border-border rounded-md p-4">
      <p class="text-xs text-text-muted uppercase tracking-wide">下書き（7日）</p>
      <p class="text-3xl font-semibold text-text-primary mt-1">{stats.draftsThisWeek}</p>
    </div>
  </div>

  <!-- Quick links -->
  <div class="flex gap-3 mb-8">
    <a href="/admin/feed" class="btn-primary text-sm">ニュースフィードを見る</a>
    <a href="/admin/sources/new" class="btn-secondary text-sm">ソースを追加</a>
    <a href="/admin/drafts" class="btn-secondary text-sm">下書き履歴</a>
  </div>

  <!-- Recent runs -->
  <div class="bg-surface border border-border rounded-md">
    <div class="px-5 py-3 border-b border-border">
      <h2 class="text-sm font-semibold text-text-primary">最近のIngestion実行</h2>
    </div>
    <div class="divide-y divide-border">
      {recentRuns?.length === 0 && (
        <p class="px-5 py-4 text-sm text-text-muted">まだ実行履歴がありません</p>
      )}
      {recentRuns?.map(run => (
        <div class="px-5 py-3 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class:list={[
              'inline-block w-2 h-2 rounded-full',
              run.status === 'completed' ? 'bg-score-high' :
              run.status === 'failed'    ? 'bg-score-low' : 'bg-score-mid',
            ]} />
            <span class="text-sm text-text-primary">{run.sources?.name ?? '不明'}</span>
            <span class="text-xs text-text-muted">
              {run.items_inserted} 件追加 / {run.items_found} 件発見
            </span>
          </div>
          <span class="text-xs text-text-muted">
            {new Date(run.started_at).toLocaleString('ja-JP')}
          </span>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>
