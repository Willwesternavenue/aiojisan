# AI Oji-san Blog System — Environment Variables
# Copy this file to .env and fill in your values

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic (optional — future use) ────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── WordPress ─────────────────────────────────────────────
WORDPRESS_BASE_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=your-wp-username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Admin Auth ────────────────────────────────────────────
# Simple secret for protecting admin routes and cron endpoints
ADMIN_SECRET=your-random-secret-string

# ── Cron Protection ───────────────────────────────────────
CRON_SECRET=your-cron-secret-string

# ── X Auto Posting (optional) ─────────────────────────────
# Required only when auto-posting published articles to X
# X_API_KEY=your-x-api-key
# X_API_SECRET=your-x-api-secret
# X_ACCESS_TOKEN=your-x-access-token
# X_ACCESS_TOKEN_SECRET=your-x-access-token-secret
